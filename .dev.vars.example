# Create an OAuth 2.0 Web application in Google Cloud Console.
# Add http://localhost:5173/auth/google/callback for local development.
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
SESSION_SECRET="replace-with-at-least-32-random-characters"

# DB is a Wrangler D1 binding configured in wrangler.json, not a secret.
# Run `npm run db:migrate:local` before starting local development.
