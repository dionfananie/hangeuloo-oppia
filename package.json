{
	"name": "hangeuloo-oppia",
	"description": "Gamified Korean learning and AI interview practice on Cloudflare Workers.",
	"cloudflare": {
		"label": "React Router Framework Starter",
		"products": [
			"Workers"
		],
		"categories": [
			"storage"
		],
		"preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/36a99c4a-8919-4e6e-ac9e-e55974407200/public",
		"preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/65455e96-7992-425f-44e4-30f3e7d7f900/preview",
		"publish": true
	},
	"dependencies": {
		"@react-router/express": "7.18.3",
		"express": "5.1.0",
		"isbot": "5.1.32",
		"react": "19.2.1",
		"react-dom": "19.2.1",
		"react-router": "7.18.3"
	},
	"devDependencies": {
		"@react-router/dev": "7.18.3",
		"@rsbuild/core": "2.2.5",
		"@rsbuild/plugin-react": "2.1.0",
		"@types/node": "24.10.1",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"prettier": "3.9.6",
		"rsbuild-plugin-react-router": "0.7.0",
		"tailwindcss": "4.1.17",
		"typescript": "5.9.3",
		"wrangler": "4.127.0"
	},
	"private": true,
	"scripts": {
		"build": "rsbuild build",
		"cf-typegen": "wrangler types && react-router typegen",
		"check": "tsc && react-router build && wrangler deploy --dry-run",
		"db:migrate:local": "wrangler d1 migrations apply hangeuloo-oppia --local",
		"db:migrate:remote": "wrangler d1 migrations apply hangeuloo-oppia --remote",
		"deploy": "wrangler deploy",
		"dev": "NODE_OPTIONS=--experimental-vm-modules node server/rsbuild-dev.mjs",
		"dev:rsbuild": "NODE_OPTIONS=--experimental-vm-modules node server/rsbuild-dev.mjs",
		"format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"workers/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs,ts}\"",
		"format:check": "prettier --check \"app/**/*.{ts,tsx,css}\" \"workers/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs,ts}\"",
		"images:generate": "node scripts/generate-vocabulary-images.mjs",
		"preview": "npm run build && wrangler dev --port 4173 --config wrangler.json",
		"test": "node --experimental-strip-types --test tests/*.test.ts",
		"typecheck": "react-router typegen && tsc --noEmit"
	},
	"type": "module"
}
